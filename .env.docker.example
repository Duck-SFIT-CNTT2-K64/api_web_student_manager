# Copy this file to .env.docker before running docker compose.
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
DB_NAME=QLSV_TrungTamTinHoc
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
FLASK_SECRET_KEY=change-this-to-a-random-secret
GOOGLE_API_KEY=your-google-api-key-here
SHOPAIKEY_API_KEY=your-shopaikey-api-key-here
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
ASSISTANT_MODEL_ORDER=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_MAX_OUTPUT_TOKENS=512
APP_PORT=5000
MSSQL_PORT=1433

# Bulk sample data (15 GV + 35 SV + …) — seed_bulk_data.sql
#   auto    : chạy nếu file /scripts/seed_bulk_data.sql tồn tại (mặc định).
#   always  : luôn chạy, exit với lỗi nếu file không tồn tại.
#   never   : bỏ qua bước bulk seed.
RUN_BULK_SEED=auto
