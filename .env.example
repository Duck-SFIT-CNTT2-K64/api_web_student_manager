DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=DESKTOP-LJTIROB\SQLEXPRESS
DB_NAME=QLSV_TrungTamTinHoc
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes
FLASK_SECRET_KEY=change-this-to-a-random-secret
# Google Gemini API Key (do NOT commit real key)
GOOGLE_API_KEY=your-google-api-key-here
# ShopAIKey (Gemini via proxy baseUrl)
SHOPAIKEY_API_KEY=your-shopaikey-api-key-here
SHOPAIKEY_BASE_URL=https://api.shopaikey.com
# Comma-separated model order for fallback (demo-safe)
ASSISTANT_MODEL_ORDER=gemini-2.5-pro,gemini-2.5-flash,gemini-2.0-flash
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_MAX_OUTPUT_TOKENS=512
# If not using trusted connection:
# DB_USER=sa
# DB_PASSWORD=YourStrongPassword
